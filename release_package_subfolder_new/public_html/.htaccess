RewriteEngine On
RewriteBase /new/

# Allow existing files and directories directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Route /api/* directly to backend router
RewriteRule ^api(/.*)?$ backend/public/router.php [L,QSA]
RewriteRule ^backend/public/api(/.*)?$ backend/public/router.php [L,QSA]

# Try exact html file
RewriteCond %{DOCUMENT_ROOT}/new/$1.html -f
RewriteRule ^(.*)$ $1.html [L]

# Try directory index.html
RewriteCond %{DOCUMENT_ROOT}/new/$1/index.html -f
RewriteRule ^(.*)$ $1/index.html [L]

# Fallback to index.html for clientside routes
RewriteRule ^.*$ index.html [L]
